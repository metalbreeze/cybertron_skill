{
  "autoMemoryDirectory": ".claude/memory",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/archive-session.sh",
            "timeout": 120,
            "statusMessage": "Archiving session transcript into docs/sessions/"
          }
        ]
      }
    ]
  }
}
